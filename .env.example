# Copy this file to .env.local and fill these values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging > Web Push certificates (needed for browser/device push alerts).
VITE_FIREBASE_VAPID_KEY=

# Set true only when running Firebase emulators locally.
VITE_USE_FIREBASE_EMULATORS=false

# Email reminders are sent by Cloud Functions using Resend.
# Configure with Firebase Secret Manager (do not put these in VITE_ variables):
# firebase functions:secrets:set RESEND_API_KEY
# Set EMAIL_FROM in functions/.env.<your-firebase-project-id>
# Example: EMAIL_FROM="SaarthiCare <reminders@your-verified-domain.com>"
